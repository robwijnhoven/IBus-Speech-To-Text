[Unit]
Description=ydotoold - generic command-line automation tool daemon (user)
Documentation=man:ydotoold(8)
# Wait for the graphical session so XDG_RUNTIME_DIR (/run/user/UID) exists for
# the socket. PartOf graphical-session keeps it tied to the desktop session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Socket lives in the per-user runtime dir; 0600 + user ownership means only
# this user can inject input. The IBus engine talks to it via ydotool, which
# defaults to exactly this path ($XDG_RUNTIME_DIR/.ydotool_socket).
ExecStart=/usr/local/bin/ydotoold --socket-path=%t/.ydotool_socket --socket-perm=0600
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
